# Copy to .env and fill in. .env is gitignored — never commit real values.

# Initial admin created on first startup if the user store is empty.
BOOTSTRAP_ADMIN_EMAIL=admin@local
BOOTSTRAP_ADMIN_PASSWORD=ChangeMeAtFirstLogin!
BOOTSTRAP_ADMIN_NAME=Admin

# Optional: pin a fixed session-cookie secret. If unset, a random 32-byte
# secret is generated on first boot and persisted to data/session_secret.
# SESSION_SECRET=
